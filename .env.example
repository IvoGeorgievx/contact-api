NODE_ENV=production
PORT=3000

ALLOWED_ORIGINS=https://example.com

# Add the verified Docker ingress peer IP for host Nginx -> container deployments.
# See README before deploying; loopback alone may make all visitors share a quota.
TRUSTED_PROXIES=loopback

SQLITE_PATH=/app/data/app.db
IP_HASH_SECRET=replace-with-long-random-secret

TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_CHAT_ID=replace-with-telegram-chat-id
